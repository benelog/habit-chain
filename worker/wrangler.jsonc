{
  // habit-chain: 화면(HTML 조각)과 DoltHub 읽기·쓰기를 한 곳에서 다 한다.
  //
  // Pages advanced mode다. 빌드 산출물의 _worker.js 하나가 모든 요청을 먼저 받고,
  // 자기가 모르는 경로만 env.ASSETS로 넘긴다. Worker + Static Assets 때 필요했던
  // run_worker_first 목록이 여기서는 통째로 사라진다.
  //
  // Worker가 아니라 Pages인 이유는 도메인이다. chain.benelog.net의 DNS는 Netlify에
  // 있는데, Workers 커스텀 도메인은 Cloudflare 존을 요구한다. Pages는 서브도메인이면
  // 외부 DNS에 CNAME 한 줄로 붙는다.
  //
  // 빌드: npm run build
  // 배포: npm run deploy
  //
  // 시크릿은 없다. DoltHub DB와 토큰은 사용자가 설정에 넣고, 요청마다 헤더로 온다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "habit-chain",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-08-01",
  "vars": {
    // 설정이 빈 사람에게 보여 줄 DB. 토큰이 없으면 읽기만 된다.
    "DEFAULT_DB": "benelog/habit-chain",
    "DOLT_BRANCH": "main"
  }
}
