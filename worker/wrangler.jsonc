{
  // habit-chain: rendering and DoltHub reads/writes in one place.
  //
  // Pages advanced mode. The built _worker.js takes every request first and
  // hands off only unknown paths to env.ASSETS, which removes the
  // run_worker_first list that Worker + Static Assets needed.
  //
  // Pages rather than Workers because of DNS: chain.benelog.net is served from
  // Netlify, and a Workers custom domain requires a Cloudflare zone. Pages
  // attaches to an external subdomain with one CNAME.
  //
  // Build: npm run build. Deploy: npm run deploy.
  //
  // No secrets — the DoltHub DB and token come from user settings as headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "habit-chain",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-08-01",
  "vars": {
    // The branch is all the server knows; the DB arrives as a header.
    "DOLT_BRANCH": "main"
  }
}
